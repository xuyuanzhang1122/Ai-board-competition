-    /**
-     * 根据ContentType获取文件扩展名
-     */
-    private String getExtensionFromContentType(String contentType) {
-        if (contentType == null) {
-            return ".jpg";
-        }
-        return switch (contentType.toLowerCase()) {
-            case "image/png" -> ".png";
-            case "image/jpeg", "image/jpg" -> ".jpg";
-            case "image/webp" -> ".webp";
-            case "image/gif" -> ".gif";
-            default -> ".jpg";
-        };
-    }
