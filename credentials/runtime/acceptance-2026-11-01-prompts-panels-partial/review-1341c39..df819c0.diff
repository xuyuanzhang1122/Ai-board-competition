+  const client = Object.assign(() => Promise.resolve('request'), { put: () => Promise.resolve('updated') })
+  const guarded = guardTargetDependencies({ api: client }, () => true)
+  await expect(guarded.api.put()).resolves.toBe('updated')
+})
