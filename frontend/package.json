{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{css,less}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "type-check": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@lobehub/ui": "^5.17.2",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.4",
    "antd": "^6.4.5",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@lobehub/commitlint-config": "^2.1.5",
    "@lobehub/eslint-config": "^2.1.5",
    "@lobehub/prettier-config": "^2.1.5",
    "@lobehub/stylelint-config": "^2.1.5",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.6.0",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.69.0",
    "prettier": "^3.8.5",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,yml,yaml}": [
      "eslint --fix"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{css,less,scss}": [
      "stylelint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "simple-git-hooks",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
