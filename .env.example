# Backend runtime
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/ai_story_studio?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# Initial admin, read on backend startup. Leave blank to skip initialization.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=超级管理员

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes

# Storage: local (dev) or cos (Tencent Cloud COS)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL_PREFIX=/uploads
# Tencent Cloud COS (bucket name includes the APPID suffix, e.g. mybucket-1250000000)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_URL_PREFIX=

# SMS
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=


# Competition text defaults; official providers stay disabled until account and price verification.
AI_TEXT_MODEL=deepseek-flash
AI_TEXT_MAX_TOKENS=4096
AI_TEXT_TEMPERATURE=0.7
AI_TEXT_TOP_P=0.9
ai.text-providers.deepseek.enabled=false
ai.text-providers.deepseek.base-url=https://api.deepseek.com
ai.text-providers.deepseek.api-key=
ai.text-providers.mimo.enabled=false
ai.text-providers.mimo.base-url=https://api.xiaomimimo.com/v1
ai.text-providers.mimo.api-key=
competition.text-budget.enabled=false

# Image/video generation is unavailable until official adapter and shared-budget verification.
# Historical media, uploads and exports remain available. No legacy provider credentials are consumed.
AI_IMAGE_DEFAULT_MODEL=
AI_IMAGE_DEFAULT_ASPECT_RATIO=16:9
AI_IMAGE_DEFAULT_COUNT=1
AI_VIDEO_MODEL=
AI_VIDEO_DEFAULT_ASPECT_RATIO=16:9
AI_VIDEO_DEFAULT_DURATION=5
AI_VIDEO_MAX_DURATION=15
AI_VIDEO_POLL_INTERVAL=15000
AI_VIDEO_MAX_POLL_COUNT=80
VIDEO_STYLE_PROMPT_3DGC=
VIDEO_STYLE_PROMPT_REALISTIC=

# WeChat Pay
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=classpath:wechat/test_key.pem
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/recharge/notify/wechat
