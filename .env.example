# Backend runtime
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/ai_story_studio?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# Initial admin, read on backend startup. Leave blank to skip initialization.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=超级管理员

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes

# Storage: local (dev) or cos (Tencent Cloud COS)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL_PREFIX=/uploads
# Tencent Cloud COS (bucket name includes the APPID suffix, e.g. mybucket-1250000000)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_URL_PREFIX=

# SMS
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=


# Geeknow provider (default)
GEEKNOW_BASE_URL=https://www.geeknow.top
GEEKNOW_FALLBACK_BASE_URL=https://geeknow.ai
GEEKNOW_API_KEY=
GEEKNOW_TIMEOUT=60000
GEEKNOW_CONNECT_TIMEOUT=10000
GEEKNOW_READ_TIMEOUT=60000

# Text generation defaults
AI_TEXT_MODEL=gemini-3.5-flash
AI_TEXT_MAX_TOKENS=4096
AI_TEXT_TEMPERATURE=0.7
AI_TEXT_TOP_P=0.9

# Image generation defaults
AI_IMAGE_DEFAULT_MODEL=gemini-3-pro-image-preview
AI_IMAGE_DEFAULT_ASPECT_RATIO=21:9
AI_IMAGE_DEFAULT_COUNT=1

# sudashuiapi Seedance video provider
SUDASHUI_VIDEO_BASE_URL=https://api.sudashuiapi.com
SUDASHUI_VIDEO_API_KEY=
SUDASHUI_VIDEO_CONNECT_TIMEOUT=10000
SUDASHUI_VIDEO_READ_TIMEOUT=120000

# Video generation defaults
# Models: sd-2-720p / sd-2-1080p / sd-api-2-720p / sd-api-2-1080p /
#         sd-2-fast-720p / sd-api-2-fast-720p (sd-api-* bypasses the real-face restriction)
AI_VIDEO_MODEL=sd-api-2-fast-720p
AI_VIDEO_DEFAULT_ASPECT_RATIO=16:9
AI_VIDEO_DEFAULT_DURATION=5
AI_VIDEO_MAX_DURATION=15
AI_VIDEO_POLL_INTERVAL=15000
AI_VIDEO_MAX_POLL_COUNT=80

# Project style -> video prompt prefix (prepended to the generation prompt
# for projects with matching styleCode). Leave blank to add nothing.
VIDEO_STYLE_PROMPT_3DGC=
VIDEO_STYLE_PROMPT_REALISTIC=超写实真人实拍质感，杜比视界HDR，广色域，光影层次丰富，视觉张力拉满，主视角与仰拍为主，极具压迫感与恢弘感，人物对话切换第一视角拍摄，虚拟屏幕(HUD)特效无穿帮，无畸变、人物物理规则：人物动作带重量感，步伐有力，衣角自然飘动；面部肌肉随情绪自然牵动，无生硬变形，表情丝滑渐进过渡，自带生理性眨眼、呼吸带动的轻微颔首，眼皮与眼球协同转动，情绪精准传达，无人物畸形，全程人物服装、发型高度统一。

# DeepSeek text models: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# Agnes is retained for text generation only.
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_API_KEY=
AGNES_CHAT_MODEL=agnes-2.0-flash

# WeChat Pay
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=classpath:wechat/test_key.pem
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/recharge/notify/wechat
